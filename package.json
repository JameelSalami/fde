{
  "name": "fde",
  "version": "0.3.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "Industrial investigation and improvement workbench with source-bound ERPNext/OpenMES review",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "fde": "bin/fde.mjs",
    "fde-web": "bin/fde-web.mjs",
    "fde-app": "bin/fde-app.mjs",
    "fde-company": "bin/fde-company.mjs",
    "fde-evidence": "bin/fde-evidence.mjs"
  },
  "files": [
    "dist/src",
    "bin",
    "CONTRACT.md",
    "INVARIANTS.md",
    "COHERENCE.md",
    "ARCHITECTURE.md",
    "STATUS.md",
    "README.md",
    "PROVENANCE.md",
    "docs",
    "web"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "kernel:build": "node scripts/build-kernel.mjs",
    "kernel:test": "node scripts/test-kernel.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "node --test dist/test/*.test.js",
    "verify": "npm run qa:offline && npm run qa:mutants && npm run ai:budget-test && npm run kernel:build && npm run web:check && npm run check && npm run build && npm run package:check && npm run kernel:test && npm test",
    "qa:offline": "python3 -m unittest discover -s integrations/engineer-qa/tests -v",
    "qa:mutants": "python3 scripts/verify-bridge-mutants.py",
    "ai:budget-test": "PYTHONPATH=integrations/operations-excel python3 -m unittest discover -s integrations/operations-excel/tests -p test_budget.py -v",
    "mutants": "node scripts/mutants.mjs all",
    "demo": "node bin/fde.mjs demo",
    "probe:lab": "node bin/fde.mjs probe:lab",
    "web:check": "node --check web/app.js && node --check bin/fde-web.mjs && node --check bin/fde-app.mjs && node --check bin/fde-company.mjs && node --check web/workbench.js",
    "web": "node bin/fde-web.mjs",
    "app": "node bin/fde-app.mjs",
    "release:package": "node scripts/package-release.mjs",
    "backup": "node scripts/backup-review.mjs",
    "mutants:admission": "node kernel/scripts/admission-mutants.mjs all",
    "mutants:host": "node scripts/w1-host-mutants.mjs",
    "ai:eval": "node scripts/evaluate-investigation.mjs",
    "package:generate": "npm run build && node scripts/generate-w1-package.mjs",
    "package:check": "node scripts/generate-w1-package.mjs --check --omit-private-markdown",
    "mutants:industrial": "node kernel/scripts/industrial-mutants.mjs all",
    "mutants:workbench": "node scripts/workbench-host-mutants.mjs",
    "backup:workbench": "node scripts/backup-workbench.mjs"
  },
  "dependencies": {
    "mariadb": "3.5.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.22.1 <23"
  }
}
